  "sql_shapes": {
    "SELECT fx_pair.id, fx_pair.currency_code, fx_pair.currency_name, fx_pair.status, fx_pair.archived, fx_pair.gold_reserve, fx_pair.foreign_reserve, fx_pair.initial_price, fx_pair.buy_fee_rate, fx_pair.sell_fee_rate, fx_pair.short_lending_limit_foreign, fx_pair.pool_version, fx_pair.reduce_only, fx_pair.created_at, fx_pair.updated_at \nFROM fx_pair \nWHERE fx_pair.id = $1::INTEGER FOR UPDATE": 64,
    "SELECT \"user\".id, \"user\".casdoor_id, \"user\".username, \"user\".email, \"user\".is_active, \"user\".is_superuser, \"user\".is_bot, \"user\".cash, \"user\".debt, \"user\".auto_repay, \"user\".debt_last_accrued_at, \"user\".tos_accepted_at, \"user\".last_liquidated_at, \"user\".economic_version, \"user\".credit_frozen, \"user\".equipped_title_id \nFROM \"user\" \nWHERE \"user\".id = $1::INTEGER FOR UPDATE": 64,
    "SELECT fx_execution.id, fx_execution.user_id, fx_execution.pair_id, fx_execution.idempotency_key, fx_execution.request_payload, fx_execution.response_version, fx_execution.response_payload, fx_execution.created_at, EXISTS (SELECT fx_trade.id \nFROM fx_trade \nWHERE fx_trade.user_id = $1::INTEGER AND fx_trade.idempotency_key = $2::VARCHAR) AS anon_1 \nFROM (SELECT $3::INTEGER AS anchor) AS anon_2 LEFT OUTER JOIN fx_execution ON fx_execution.user_id = $1::INTEGER AND fx_execution.idempotency_key = $2::VARCHAR": 64,
    "SELECT fx_wallet.id, fx_wallet.user_id, fx_wallet.pair_id, fx_wallet.foreign_amount, fx_wallet.cost_basis, fx_wallet.updated_at \nFROM fx_wallet \nWHERE fx_wallet.user_id = $1::INTEGER AND fx_wallet.pair_id = $2::INTEGER FOR UPDATE": 64,
    "SELECT fx_short_position.id, fx_short_position.user_id, fx_short_position.pair_id, fx_short_position.principal_foreign, fx_short_position.interest_foreign, fx_short_position.interest_last_accrued_at, fx_short_position.proceeds_basis_gold, fx_short_position.created_at, fx_short_position.updated_at \nFROM fx_short_position \nWHERE fx_short_position.user_id = $1::INTEGER ORDER BY fx_short_position.pair_id ASC FOR UPDATE": 64,
    "SELECT position.outcome_id, position.amount, outcome.market_id \nFROM position JOIN outcome ON outcome.id = position.outcome_id \nWHERE position.user_id = $1::INTEGER AND position.amount > $2::NUMERIC(16, 6)": 64,
    "SELECT fx_wallet.pair_id, fx_wallet.foreign_amount \nFROM fx_wallet \nWHERE fx_wallet.user_id = $1::INTEGER AND fx_wallet.foreign_amount > $2::NUMERIC(16, 6)": 64,
    "SELECT siteconfig.key, siteconfig.value \nFROM siteconfig \nWHERE siteconfig.key IN ($1::VARCHAR, $2::VARCHAR, $3::VARCHAR)": 64,
    "SELECT fx_treasury.id, fx_treasury.pair_id, fx_treasury.gold_balance, fx_treasury.foreign_balance, fx_treasury.updated_at \nFROM fx_treasury \nWHERE fx_treasury.pair_id = $1::INTEGER FOR UPDATE": 64,
    "INSERT INTO fx_execution (user_id, pair_id, idempotency_key, request_payload, response_version, response_payload, created_at) VALUES ($1::INTEGER, $2::INTEGER, $3::VARCHAR, $4::JSON, $5::INTEGER, $6::JSON, $7::TIMESTAMP WITH TIME ZONE) RETURNING fx_execution.id": 64,
    "UPDATE \"user\" SET cash=$1::NUMERIC(16, 6), debt=$2::NUMERIC(16, 6), debt_last_accrued_at=$3::TIMESTAMP WITH TIME ZONE, economic_version=$4::INTEGER WHERE \"user\".id = $5::INTEGER": 64,
    "INSERT INTO ledger_entry (user_id, entry_type, cash_delta, debt_delta, cash_after, debt_after, debt_last_accrued_at_after, daily_rate_at_event, operator_user_id, reason, created_at) VALUES ($1::INTEGER, $2::VARCHAR, $3::NUMERIC(16, 6), $4::NUMERIC(16, 6), $5::NUMERIC(16, 6), $6::NUMERIC(16, 6), $7::TIMESTAMP WITH TIME ZONE, $8::NUMERIC(16, 8), $9::INTEGER, $10::VARCHAR, $11::TIMESTAMP WITH TIME ZONE) RETURNING ledger_entry.id": 64,
    "INSERT INTO audit_event (ts, event_type, user_id, market_id, outcome_id, operator_user_id, ref_table, ref_id, payload, user_after, position_after, market_after) VALUES ($1::TIMESTAMP WITH TIME ZONE, $2::VARCHAR, $3::INTEGER, $4::INTEGER, $5::INTEGER, $6::INTEGER, $7::VARCHAR, $8::INTEGER, $9::JSON, $10::JSON, $11::JSON, $12::JSON) RETURNING audit_event.id": 128,
    "UPDATE \"user\" SET cash=$1::NUMERIC(16, 6), economic_version=$2::INTEGER WHERE \"user\".id = $3::INTEGER": 64,
    "UPDATE fx_pair SET gold_reserve=$1::NUMERIC(16, 6), foreign_reserve=$2::NUMERIC(16, 6), pool_version=$3::INTEGER, updated_at=$4::TIMESTAMP WITH TIME ZONE WHERE fx_pair.id = $5::INTEGER": 64,
    "INSERT INTO fx_trade (execution_id, execution_leg, pair_id, user_id, purpose, requested_foreign_amount, borrow_amount, max_gold_in, cover_all, side, input_amount, output_amount, min_out, fee_amount, pre_gold_reserve, pre_foreign_reserve, post_gold_reserve, post_foreign_reserve, post_price, source, idempotency_key, created_at) VALUES ($1::INTEGER, $2::INTEGER, $3::INTEGER, $4::INTEGER, $5::VARCHAR, $6::NUMERIC(24, 6), $7::NUMERIC(16, 6), $8::NUMERIC(16, 6), $9::BOOLEAN, $10::VARCHAR, $11::NUMERIC(16, 6), $12::NUMERIC(16, 6), $13::NUMERIC(16, 6), $14::NUMERIC(16, 6), $15::NUMERIC(16, 6), $16::NUMERIC(16, 6), $17::NUMERIC(16, 6), $18::NUMERIC(16, 6), $19::NUMERIC(16, 6), $20::VARCHAR, $21::VARCHAR, $22::TIMESTAMP WITH TIME ZONE) RETURNING fx_trade.id": 64,
    "UPDATE fx_treasury SET gold_balance=$1::NUMERIC(16, 6), updated_at=$2::TIMESTAMP WITH TIME ZONE WHERE fx_treasury.id = $3::INTEGER": 64,
    "UPDATE fx_wallet SET foreign_amount=$1::NUMERIC(16, 6), cost_basis=$2::NUMERIC(16, 6), updated_at=$3::TIMESTAMP WITH TIME ZONE WHERE fx_wallet.id = $4::INTEGER": 64,
    "UPDATE fx_execution SET response_payload=$1::JSON WHERE fx_execution.id = $2::INTEGER": 64,
    "INSERT INTO fx_pool_event (pair_id, created_at, kind, pre_gold_reserve, pre_foreign_reserve, post_gold_reserve, post_foreign_reserve, gold_volume, trade_id, audit_id) VALUES ($1::INTEGER, $2::TIMESTAMP WITH TIME ZONE, $3::VARCHAR, $4::NUMERIC(16, 6), $5::NUMERIC(16, 6), $6::NUMERIC(16, 6), $7::NUMERIC(16, 6), $8::NUMERIC(16, 6), $9::INTEGER, $10::BIGINT) RETURNING fx_pool_event.id": 64
  },
