+                @wraps(function)
+                async def seeded(*args, **kwargs):
+                    result = await function(*args, **kwargs)
+                    await publish_seeded_market_records()
+                    return result
+                return seeded
+            monkeypatch.setattr(request.module, name, wrap(value))
