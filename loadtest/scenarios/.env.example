# 复制为 .env，从 seed_markets.sh 输出里抓 HOT_2OPT 的 market.id 和两个 outcome.id 填入。
# k6 run 时通过 -e KEY=VAL 传入（也可以 source 这个文件后再 k6 run）。
#
# BASE_URL 选一个：
#   同机压测（绕过 nginx，CPU 争抢严重，结果偏悲观）：
#     BASE_URL=http://127.0.0.1:8004
#   远程压测（经过 nginx+HTTPS，结果更真实，推荐）：
#     BASE_URL=https://your-instance.example.com
#   需确保远程机器 IP 已加入 nginx geo 白名单，否则会收到大量 429。

BASE_URL=https://your-instance.example.com
HOT_MARKET_ID=
HOT_OUTCOME_YES=
HOT_OUTCOME_NO=
TOKENS_FILE=../../tokens.txt
