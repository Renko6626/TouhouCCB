# ========================================
# TouhouCCB 环境变量（唯一配置文件）
# 复制为 .env 并填入实际值
#
# docker-compose.yml 和后端应用都从这一个文件读取，
# 不需要在 backend/ 下再建 .env。
# ========================================

# --- 环境 ---
APP_ENV=development                              # "development" | "production"

# --- Docker ---
UID=1000                                         # 容器内用户 UID（改成你的 `id -u`）
GID=1000                                         # 容器内用户 GID（改成你的 `id -g`）

# 后端镜像来源：
# - 留空（保持注释）→ docker compose 用本地 ./backend 构建（开发 / 单机自建）
# - 生产从 registry 拉预构建镜像时**必须填**完整地址，否则 deploy.sh 的
#   `docker compose pull backend` 会去拉不存在的 thccb-backend:latest 而失败回滚。
# 例：BACKEND_IMAGE=registry.example.com/<namespace>/thccb-backend:latest
# BACKEND_IMAGE=

# --- 安全 ---
SECRET_KEY=change_me_to_a_random_string         # JWT 签名密钥，至少 32 字符
ADMIN_SECRET_KEY=                                # Admin 面板 session 密钥，留空自动生成

# --- Casdoor SSO（后端只需这 3 项）---
CASDOOR_ENDPOINT=https://auth.example.com
CASDOOR_CLIENT_ID=your-client-id
CASDOOR_CLIENT_SECRET=your-client-secret

# --- 弹幕兑换 HMAC 密钥（可选功能，与外部 danmuku 服务端共享）---
# 不设则用 config.py 的占位默认值；生产请取消注释并填随机串，与 danmuku 服务端保持一致
# DANMUKU_SECRET_KEY=

# --- 前端 URL（用于 OAuth redirect_uri）---
FRONTEND_URL=http://localhost:5173

# --- 数据库（PostgreSQL，Docker Compose 默认）---
DB_BACKEND=postgres
PG_HOST=postgres
PG_PORT=5432
PG_USER=thccb
PG_PASSWORD=change_me
PG_DB=thccb

# SQLite（本地开发用，无需额外服务）
# DB_BACKEND=sqlite
# SQLITE_PATH=data/thccb.db

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- 游戏 ---
INITIAL_BALANCE=100.0
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Anti-bot HMAC SECRET ──
# 后端验证 X-Client-Token 用；activity_mode_enabled=false 时不验也可空
# 生产生成：python -c "import secrets; print(secrets.token_hex(32))"
CLIENT_TOKEN_SECRET=

# 前端 vite build 用 (CI 通过 GitHub Actions secrets VITE_CLIENT_TOKEN_SECRET 注入)
# 跟后端 CLIENT_TOKEN_SECRET 必须一致
# VITE_CLIENT_TOKEN_SECRET=<同 CLIENT_TOKEN_SECRET>
