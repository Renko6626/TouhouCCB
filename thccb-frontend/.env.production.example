# 前端生产构建环境变量（复制为 .env.production 后填入你的实例值）
# 注意：.env.production 已被 .gitignore 忽略，请勿提交真实配置；
# CI 构建请改用仓库 Secrets 注入这些变量。

# 后端 API 地址
VITE_API_BASE_URL=https://your-instance.example.com

# 站点标题（前端展示用）
VITE_APP_TITLE=东方炒炒币

# Casdoor SSO 配置（指向你自建的 Casdoor 实例）
VITE_CASDOOR_URL=https://your-casdoor.example.com
VITE_CASDOOR_CLIENT_ID=YOUR_CASDOOR_CLIENT_ID
VITE_CASDOOR_ORG=YOUR_ORG_NAME
VITE_CASDOOR_APP=YOUR_APP_NAME
