% 东方FX天则规则书的局部排版，沿用共用字体与页面尺寸。
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{fxrulebook}[2026/10/16 FX Rulebook Layout]
\RequirePackage{touhouccb}
\RequirePackage{needspace}

\definecolor{fxLong}{HTML}{1E40AF}
\definecolor{fxShort}{HTML}{9A6700}
\definecolor{fxLine}{HTML}{C8C7C0}

% 案例、计算、剧情各有固定的视觉语义。
\renewtcolorbox{exbox}[1][]{
  colback=white,colframe=fxLine,boxrule=0.6pt,
  colbacktitle=lightGray,coltitle=ink,title={例},
  borderline west={2pt}{0pt}{ink},
  fonttitle=\sffamily\bfseries,
  before skip=9pt,after skip=9pt,
  #1
}
\renewtcolorbox{mathbox}[1][]{
  colback=boxBg!55!white,colframe=goldAccent!45,boxrule=0.5pt,
  borderline west={2pt}{0pt}{goldAccent},
  before skip=9pt,after skip=9pt,
  #1
}
\renewtcolorbox{lorebox}[1][]{
  colback=goldAccent!4!white,colframe=goldAccent!45,boxrule=0.4pt,
  borderline west={2pt}{0pt}{goldAccent},
  colbacktitle=goldAccent,coltitle=white,
  fontupper=\kai,
  before upper={\setlength{\parskip}{0.45em}},
  before skip=8pt,after skip=9pt,
  #1
}

\newtcolorbox{fxposition}[2]{
  colback=#1!3!white,colframe=#1,boxrule=0.7pt,
  colbacktitle=#1!9!white,coltitle=#1,title={#2},
  fonttitle=\sffamily\bfseries,
  height=43mm,valign=center,breakable=false,
  left=10pt,right=10pt,top=8pt,bottom=8pt,
  before skip=0pt,after skip=0pt,
}
\newtcolorbox{fxworkflow}[1]{
  colback=white,colframe=goldAccent,boxrule=0.7pt,
  colbacktitle=goldAccent,coltitle=white,title={#1},
  fonttitle=\sffamily\bfseries,
  left=10pt,right=10pt,top=10pt,bottom=9pt,
  before skip=9pt,after skip=9pt,breakable=false,
}

\newcommand{\fxstep}[2]{%
  {\sffamily\bfseries\color{goldAccent}#1}\par\smallskip #2}
