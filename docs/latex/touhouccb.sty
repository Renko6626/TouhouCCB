% ============================================================
%  touhouccb.sty
%  东方炒炒币规则书 -- 排版样式包
%  所有排版设定 / 颜色 / callout 盒子 / 自定义命令都在这里
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{touhouccb}[2026/05/14 TouhouCCB Rulebook Style]

% -------- 页面几何 --------
\RequirePackage{geometry}
\geometry{a4paper,top=2.4cm,bottom=2.6cm,left=2.4cm,right=2.4cm,headsep=0.6cm,footskip=1.2cm}

% -------- 中文 --------
\RequirePackage[heading=true,UTF8,fontset=none]{ctex}
\setCJKmainfont[BoldFont={Noto Serif CJK SC Bold}]{Noto Serif CJK SC}
\setCJKsansfont[BoldFont={Noto Sans CJK SC Bold}]{Noto Sans CJK SC}
\setCJKmonofont{Noto Sans Mono CJK SC}
\setCJKfamilyfont{kai}{AR PL KaitiM GB}
% 开关：切到楷体，使用方式 {\kai 文字} 或环境的 fontupper=\kai
\newcommand{\kai}{\CJKfamily{kai}}

% -------- 西文字体 --------
\RequirePackage{fontspec}
\setmainfont{TeX Gyre Termes}
\setsansfont{TeX Gyre Heros}
\setmonofont{TeX Gyre Cursor}

% -------- 数学 --------
\RequirePackage{amsmath,amssymb,mathtools}

% -------- 颜色 --------
\RequirePackage[dvipsnames,table]{xcolor}
\definecolor{ink}{HTML}{0A0A0A}          % 主文字（接近纯黑）
\definecolor{paper}{HTML}{FAFAF7}        % 米白背景
\definecolor{rule}{HTML}{111111}         % 边框 / 标尺
\definecolor{soft}{HTML}{6B6B6B}         % 次要文字
\definecolor{reimuRed}{HTML}{C8102E}     % 灵梦红 / A 胜券
\definecolor{marisaBlue}{HTML}{1E40AF}   % 魔理沙蓝 / B 胜券
\definecolor{goldAccent}{HTML}{B8860B}   % 暗金 = 大天狗
\definecolor{profitGreen}{HTML}{0F7A3A}  % 涨绿
\definecolor{lossRed}{HTML}{B91C1C}      % 跌红
\definecolor{lightGray}{HTML}{EFEFEC}
\definecolor{boxBg}{HTML}{F2F2EE}

% -------- 表格 --------
\RequirePackage{booktabs,array,tabularx,colortbl,makecell}
\renewcommand{\arraystretch}{1.25}
\arrayrulecolor{rule}

% -------- 链接 / 引用 --------
\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=ink,
  urlcolor=marisaBlue,
  citecolor=ink,
  pdftitle={东方炒炒币 · 规则书},
  pdfauthor={饭纲丸龙金融市场管理委员会},
  pdfsubject={LMSR Prediction Market Rulebook},
  bookmarksnumbered=true,
}

% -------- 标题样式 --------
\RequirePackage{titlesec}
\titleformat{\section}
  {\sffamily\bfseries\Large\color{ink}}
  {\textcolor{goldAccent}{\rule[-0.05em]{0.35em}{1em}}\;\thesection}
  {0.8em}
  {}
  [\vspace{-0.3em}{\color{rule}\hrule height 1.2pt}\vspace{0.2em}]
\titleformat{\subsection}
  {\sffamily\bfseries\large\color{ink}}
  {\thesubsection}
  {0.7em}
  {}
\titleformat{\subsubsection}
  {\sffamily\bfseries\normalsize\color{ink}}
  {}
  {0em}
  {}
\titlespacing*{\section}{0pt}{1.6em}{0.8em}
\titlespacing*{\subsection}{0pt}{1.1em}{0.4em}
\titlespacing*{\subsubsection}{0pt}{0.9em}{0.3em}

% -------- 页眉页脚 --------
\RequirePackage{fancyhdr}
\setlength{\headheight}{24pt}
\setlength{\topmargin}{-1.5cm}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{rule}\leaders\hrule height \headrulewidth\hfill}}
\fancyhead[LE]{\sffamily\small\color{soft}东方炒炒币}
\fancyhead[RE]{\sffamily\small\color{soft}\leftmark}
\fancyhead[LO]{\sffamily\small\color{soft}\leftmark}
\fancyhead[RO]{\sffamily\small\color{soft}规则书}
\fancyfoot[C]{\sffamily\small\color{soft}\thepage}

% -------- 文段排版 --------
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em}
\linespread{1.18}

\RequirePackage{enumitem}
\setlist[itemize]{leftmargin=1.4em,topsep=0.2em,itemsep=0.15em,parsep=0.1em,label={\color{ink}\textbf{·}}}
\setlist[enumerate]{leftmargin=1.5em,topsep=0.2em,itemsep=0.15em,parsep=0.1em}

% -------- 工业风 callout 盒子 (tcolorbox) --------
\RequirePackage[most]{tcolorbox}
\tcbset{
  sharp corners,
  boxrule=0.9pt,
  arc=0pt,
  outer arc=0pt,
  left=10pt,right=10pt,top=8pt,bottom=8pt,
  fonttitle=\sffamily\bfseries,
  boxsep=2pt,
  enhanced,
}

\newtcolorbox{notebox}[1][]{
  colback=boxBg,colframe=rule,
  borderline west={3pt}{0pt}{ink},
  #1
}
\newtcolorbox{warnbox}[1][]{
  colback=boxBg,colframe=lossRed,
  borderline west={3pt}{0pt}{lossRed},
  title=\textcolor{lossRed}{警告},
  coltitle=lossRed,
  #1
}
\newtcolorbox{tipbox}[1][]{
  colback=boxBg,colframe=profitGreen,
  borderline west={3pt}{0pt}{profitGreen},
  title=\textcolor{profitGreen}{贴士},
  #1
}
\newtcolorbox{mathbox}[1][]{
  colback=lightGray,colframe=rule,
  borderline west={3pt}{0pt}{goldAccent},
  #1
}
\newtcolorbox{lorebox}[1][]{
  colback=lightGray,colframe=goldAccent,
  borderline west={3pt}{0pt}{goldAccent},
  fontupper=\kai,
  #1
}
\newtcolorbox{exbox}[1][]{
  colback=white,colframe=rule,
  title=\textcolor{ink}{例},
  #1
}

% A / B 胜券双栏卡片
\newtcolorbox{cardA}{
  colback=white,colframe=reimuRed,
  borderline west={4pt}{0pt}{reimuRed},
  width=0.48\linewidth,
  before=\par\noindent,
  after=\hfill,
}
\newtcolorbox{cardB}{
  colback=white,colframe=marisaBlue,
  borderline west={4pt}{0pt}{marisaBlue},
  width=0.48\linewidth,
  before=\noindent,
  after=\par,
}

% -------- 内联语义命令 --------
\newcommand{\Acard}{\textcolor{reimuRed}{\textbf{A 胜券}}}
\newcommand{\Bcard}{\textcolor{marisaBlue}{\textbf{B 胜券}}}
\newcommand{\Reimu}{\textcolor{reimuRed}{\textbf{灵梦}}}
\newcommand{\Marisa}{\textcolor{marisaBlue}{\textbf{魔理沙}}}
\newcommand{\money}[1]{\textbf{#1\,元}}
\newcommand{\up}[1]{\textcolor{profitGreen}{\textbf{#1}}}
\newcommand{\down}[1]{\textcolor{lossRed}{\textbf{#1}}}
\newcommand{\term}[1]{\textsf{\textbf{#1}}}

% “龙语录”引文样式
\newcommand{\dragonquote}[2]{%
  \begin{flushright}\kai
    \textit{“#1”}\\[-0.15em]
    \textcolor{soft}{\small —— #2}
  \end{flushright}}

% -------- 目录样式 --------
\RequirePackage{titletoc}
\titlecontents{section}
  [1.5em]
  {\addvspace{0.3em}\sffamily\bfseries}
  {\contentslabel{1.5em}}
  {\hspace*{-1.5em}}
  {\titlerule*[0.6pc]{.}\contentspage}

% -------- 浮动控制 --------
\RequirePackage{float}

\endinput
