# 抓 token 步骤见 quant/docs/get-token.md

# BASE_URL：
#   - 跨机器（量化脚本 ≠ prod docker 所在机器） → 用 prod 公网 URL
#   - 同一台机器（量化脚本和 prod docker 共处一机） → 改成 http://127.0.0.1:8004 更快、不走 nginx
THCCB_BASE_URL=https://your-instance.example.com

# 浏览器 F12 → Application → Local Storage → thccb 域名 → 复制
THCCB_ACCESS_TOKEN=eyJ_replace_me
THCCB_REFRESH_TOKEN=eyJ_replace_me
